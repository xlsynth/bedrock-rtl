# Weighted flow muxes share public-interface checks and keep separate DUT wrappers.
verilog_library(
    name = "br_flow_mux_weighted_basic_fpv_monitor",
    srcs = ["br_flow_mux_weighted_basic_fpv_monitor.sv"],
    deps = [
        ":br_flow_mux_basic_fpv_monitor",
        "//macros:br_asserts",
        "//macros:br_fv",
    ],
)

# Cover the single-flow bypass, even/odd arbitration, unit weights, non-power-of-two
# limits, and accumulated weight both equal to and greater than configured weight.
_WEIGHTED_MUX_PARAMS = {
    "MaxAccumulatedWeight": [
        "1",
        "3",
        "5",
    ],
    "MaxWeight": [
        "1",
        "2",
        "3",
    ],
    "NumFlows": [
        "1",
        "2",
        "3",
        "5",
    ],
    "Width": ["5"],
}

_WEIGHTED_MUX_ILLEGAL_PARAMS = {
    ("MaxAccumulatedWeight", "MaxWeight"): [
        ("1", "2"),
        ("1", "3"),
    ],
}

# Exercise the same four interface contracts as the other unstable muxes,
# separately from the weight sweep to keep the matrix focused.
_WEIGHTED_MUX_PROTOCOL_PARAMS = {
    "EnableAssertPushDataStability": [
        "0",
        "1",
    ],
    "EnableAssertPushValidStability": [
        "0",
        "1",
    ],
    "EnableCoverPushBackpressure": [
        "0",
        "1",
    ],
    "MaxAccumulatedWeight": ["5"],
    "MaxWeight": ["3"],
    "NumFlows": [
        "1",
        "3",
    ],
    "Width": ["1"],
}

_WEIGHTED_MUX_PROTOCOL_ILLEGAL_PARAMS = {
    (
        "EnableCoverPushBackpressure",
        "EnableAssertPushValidStability",
        "EnableAssertPushDataStability",
    ): [
        ("0", "0", "1"),
        ("0", "1", "0"),
        ("0", "1", "1"),
        ("1", "0", "1"),
    ],
}

