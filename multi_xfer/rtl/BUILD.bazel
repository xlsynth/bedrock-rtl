load("@rules_hdl//verilog:providers.bzl", "verilog_library")
load("//bazel:br_verilog.bzl", "br_verilog_elab_and_lint_test_suite", "br_verilog_synth_suite")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(["*.sv"]) + ["//multi_xfer/rtl/internal:srcs"],
)

verilog_library(
    name = "br_multi_xfer_reg_fwd",
    srcs = ["br_multi_xfer_reg_fwd.sv"],
    deps = [
        "//macros:br_asserts_internal",
        "//macros:br_registers",
        "//multi_xfer/rtl/internal:br_multi_xfer_checks_sendable_data_impl",
        "//multi_xfer/rtl/internal:br_multi_xfer_checks_sendable_data_intg",
        "//shift/rtl:br_shift_left",
        "//shift/rtl:br_shift_right",
    ],
)

br_verilog_synth_suite(
    name = "br_multi_xfer_reg_fwd_standard_ppa",
    params = {
        "NumSymbols": [
            "2",
            "4",
        ],
        "SymbolWidth": ["32"],
    },
    deps = [":br_multi_xfer_reg_fwd"],
)

br_verilog_synth_suite(
    name = "br_multi_xfer_reg_fwd_wide_ppa",
    params = {
        "NumSymbols": ["4"],
        "SymbolWidth": ["64"],
    },
    deps = [":br_multi_xfer_reg_fwd"],
)

br_verilog_elab_and_lint_test_suite(
    name = "br_multi_xfer_reg_fwd_test_suite",
    params = {
        "NumSymbols": [
            "2",
            "3",
            "4",
        ],
        "SymbolWidth": [
            "1",
            "3",
            "8",
        ],
    },
    deps = [
        ":br_multi_xfer_reg_fwd",
    ],
)

verilog_library(
    name = "br_multi_xfer_distributor_fixed",
    srcs = ["br_multi_xfer_distributor_fixed.sv"],
    deps = [
        "//arb/rtl:br_arb_multi_fixed",
        "//multi_xfer/rtl/internal:br_multi_xfer_distributor_core",
    ],
)

br_verilog_elab_and_lint_test_suite(
    name = "br_multi_xfer_distributor_fixed_test_suite",
    params = {
        "NumSymbols": [
            "2",
            "3",
        ],
        "NumFlows": [
            "3",
            "4",
        ],
        "SymbolWidth": [
            "1",
            "3",
            "8",
        ],
    },
    deps = [
        ":br_multi_xfer_distributor_fixed",
    ],
)

verilog_library(
    name = "br_multi_xfer_distributor_rr",
    srcs = ["br_multi_xfer_distributor_rr.sv"],
    deps = [
        "//arb/rtl:br_arb_multi_rr",
        "//multi_xfer/rtl/internal:br_multi_xfer_distributor_core",
    ],
)

br_verilog_synth_suite(
    name = "br_multi_xfer_distributor_rr_standard_ppa",
    params = {
        "numflows": ["4"],
        "numsymbols": ["2"],
        "symbolwidth": ["32"],
    },
    deps = [":br_multi_xfer_distributor_rr"],
)

br_verilog_synth_suite(
    name = "br_multi_xfer_distributor_rr_scaled_ppa",
    params = {
        "numflows": ["8"],
        "numsymbols": ["4"],
        "symbolwidth": ["32"],
    },
    deps = [":br_multi_xfer_distributor_rr"],
)

br_verilog_synth_suite(
    name = "br_multi_xfer_distributor_rr_wide_ppa",
    params = {
        "numflows": ["16"],
        "numsymbols": ["4"],
        "symbolwidth": ["64"],
    },
    deps = [":br_multi_xfer_distributor_rr"],
)

br_verilog_elab_and_lint_test_suite(
    name = "br_multi_xfer_distributor_rr_test_suite",
    params = {
        "numsymbols": [
            "2",
            "3",
        ],
        "numflows": [
            "3",
            "4",
        ],
        "symbolwidth": [
            "1",
            "3",
            "8",
        ],
    },
    deps = [
        ":br_multi_xfer_distributor_rr",
